{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": [
        "custom/apple",
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "network",
        "wireplumber",
        "battery",
        "clock"
    ],
    "custom/apple": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/rofi/powermenu.sh"
    },
    "hyprland/window": {
        "format": "{class}",
        "max-length": 40,
        "separate-outputs": true
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname} · {ipaddr}",
        "on-click": "kitty -e nmtui"
    },
    "wireplumber": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "tooltip-format": "Громкость: {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰂂",
            "󰁹"
        ]
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    }
}